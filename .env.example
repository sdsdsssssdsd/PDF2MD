# Example environment variables (copy to .env and fill locally).
# Never commit real values.

# --- DeepSeek-OCR-2 local Worker (formula recovery) ---
# PDF2MD_HF_HOME=
# PDF2MD_DEEPSEEK_MODEL_DIR=
# PDF2MD_DSOCR2_PYTHON=
# Idle unload model after N seconds (0 = never). Process stays up.
# DEEPSEEK_WORKER_IDLE_UNLOAD_SECONDS=3600
# DEEPSEEK_WORKER_IDLE_SHUTDOWN_SECONDS=0

# --- Optional API (not required for local OCR Worker) ---
# DEEPSEEK_API_KEY=

# --- Docling / mirrors ---
# PDF2MD_PYTHON=
# PDF2MD_DOCLING_ARTIFACTS=
# HF_ENDPOINT=
# MINERU_MODEL_SOURCE=

# --- Local benchmark scripts only ---
# PDF2MD_BENCH_PDF=
# PDF2MD_BENCH_ROOT=
# PDF2MD_BENCH_O003_MD=

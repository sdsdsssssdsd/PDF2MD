# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
.venv-*/
venv/
env/

# Local caches & models (large)
.cache/
*.safetensors
*.pth
*.pt
*.onnx
*.bin
*.gguf

# Runtime data
input/*
!input/.gitkeep
output/*
!output/.gitkeep
logs/*
!logs/.gitkeep
icons/*
!icons/.gitkeep
!icons/pdf2md.ico
!icons/pdf2md-cover.png

# User documents that must never be committed
*.pdf

# OS / IDE
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.lnk

# Secrets / local config
.env
.env.*
!.env.example
*.local
mineru.json
*.key
*.pem
*.p12
*.pfx
credentials.json

# Logs (anywhere)
*.log

# Packaging / wheels
*.whl

# Local demo conversion dumps (keep docs/images/*.png)
docs/_demo*/
outputs/

# Local-only privacy / security audit artifacts (never publish)
PRIVACY_AUDIT.md
PRIVACY_AUDIT*.md
*安全审查*.md
*隐私审计*.md
*audit*report*.md

